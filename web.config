<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <httpErrors errorMode="Custom" existingResponse="PassThrough" />
    <rewrite>
      <rules>
        <!-- Block the compromised legacy blog before any PHP/file handler. -->
        <rule name="Retired group WordPress blog" stopProcessing="true">
          <match url="^blog(/.*)?$" ignoreCase="true" />
          <action type="CustomResponse" statusCode="410" statusReason="Gone" statusDescription="This section is no longer available." />
        </rule>
        <!-- Send this legacy Wonderland Kids League URL to the group homepage. -->
        <rule name="Legacy Seedling Wonderland Kids League URL" stopProcessing="true">
          <match url="^sia\.php/swkl\.php$" ignoreCase="true" />
          <action type="Redirect" url="https://seedlingschools.com" redirectType="Permanent" appendQueryString="false" />
        </rule>
        <rule name="Canonical group hostname" stopProcessing="true">
          <match url="(.*)" />
          <conditions><add input="{HTTP_HOST}" pattern="^www\.seedlingschools\.com$" /></conditions>
          <action type="Redirect" url="https://seedlingschools.com/{R:1}" redirectType="Permanent" />
        </rule>
        <!-- Existing disclosure PDFs remain available while updated copies are collected. -->
        <rule name="Legacy disclosure PDFs" stopProcessing="true">
          <match url="^mandatory-discloser/.*\.pdf$" ignoreCase="true" />
          <conditions><add input="{REQUEST_FILENAME}" matchType="IsFile" /></conditions>
          <action type="None" />
        </rule>
        <rule name="Group static chunks" stopProcessing="true">
          <match url="^_grp/_next/(.*)" />
          <action type="Rewrite" url="http://localhost:3003/_next/{R:1}" />
        </rule>
        <!-- Legacy PHP URLs now reach the permanent mappings in next.config.ts. -->
        <rule name="Group NextJS" stopProcessing="true">
          <match url="(.*)" />
          <action type="Rewrite" url="http://localhost:3003/{R:1}" />
        </rule>
      </rules>
    </rewrite>
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
